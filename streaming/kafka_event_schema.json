
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FitPulse Workout Event",
  "description": "Event contract for simulated FitPulse workout events. Kafka infrastructure is not required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "workout_id",
    "user_id",
    "device_id",
    "activity_type",
    "event_timestamp",
    "duration_minutes",
    "calories_burned",
    "source_system",
    "schema_version"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": ["workout_completed"]
    },
    "workout_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": ["Running", "Cycling", "Walking"]
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "minimum": 0
    },
    "calories_burned": {
      "type": "number",
      "minimum": 0
    },
    "source_system": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
